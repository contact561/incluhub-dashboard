# Public Supabase client configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_STAGING_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_STAGING_ANON_KEY

# Server-only utility configuration. Never expose these values to browser code.
SUPABASE_SERVICE_ROLE_KEY=YOUR_STAGING_SERVICE_ROLE_KEY
EXPECTED_SUPABASE_PROJECT_REF=YOUR_STAGING_PROJECT_REF
PRODUCTION_SUPABASE_PROJECT_REF=YOUR_PRODUCTION_PROJECT_REF
ALLOW_DESTRUCTIVE_TEST_RESET=false
TEST_ACCOUNT_PASSWORD=SET_A_UNIQUE_LOCAL_TEST_PASSWORD
TEST_ADMIN_EMAIL=admin.fixture@example.invalid
TEST_ADMIN_PASSWORD=SET_A_UNIQUE_LOCAL_ADMIN_PASSWORD
TEST_ADMIN_FULL_NAME=QA Admin

# Optional Playwright role accounts. Use dedicated accounts in a non-production
# Supabase project; never commit their passwords.
E2E_ADMIN_EMAIL=
E2E_STUDENT_EMAIL=
E2E_EDUCATOR_EMAIL=
E2E_ACCOUNT_PASSWORD=
E2E_FIXTURE_PROJECT_REF=
ALLOW_E2E_ACCOUNT_SETUP=false

# Stage 5 destination. Leave blank until a real reviewed URL is supplied; the
# dashboard will show a safe configuration-pending state instead of a dead link.
NEXT_PUBLIC_ECOSYSTEM_APP_URL=
NEXT_PUBLIC_ECOSYSTEM_APP_NAME=IncluHub Ecosystem
NEXT_PUBLIC_ECOSYSTEM_APP_LOGO=/brand/incluhub-logo.svg
